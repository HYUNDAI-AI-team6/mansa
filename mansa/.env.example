# Railway MySQL
DATABASE_URL=mysql+pymysql://username:password@host:port/database

# Railway Chroma 벡터 DB (호스트만 적고 http(s)://, 포트는 넣지 않는다)
TECH_CHROMA_HOST=
SECURE_CHROMA_HOST=
CHROMA_PORT=

# LLM API
LLM_API_KEY=your_api_key_here

# ---- 아래는 선택 설정이다. 주석(#)을 풀고 값을 적으면 바뀌고, 그대로 두면 오른쪽 기본값을 쓴다. ----
# 비워 두면 기본값이다. 숫자가 아니거나 범위를 벗어나면 앱이 켜질 때 오류로 알려 준다.

# 문서 임베딩·청킹. 임베딩 모델은 올리는 쪽과 검색하는 쪽이 함께 쓴다.
# 바꾸면 벡터 차원이 달라져서(small 1536, large 3072) 이미 만든 컬렉션은 새로 만들어야 한다.
# EMBEDDING_MODEL=text-embedding-3-large
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# BATCH_SIZE=100

# 검색. DOC_TYPE 은 tech(기술 DB) 또는 secure(안전 DB). 컬렉션 이름은 문서를 올릴 때와 같아야 한다.
# SAFETY_DOC_TYPE=secure
# SAFETY_COLLECTION=safety_docs
# MANUAL_DOC_TYPE=tech
# MANUAL_COLLECTION=tech_docs
# CORPUS_PAGE_SIZE=500
# VECTOR_TOP_K=20
# BM25_TOP_K=20
# RESULT_TOP_K=20
# TAG_TOP_K=20
# EVIDENCE_TOP_N=8
# TAG_KEYS=part,task

# 답변 품질 기준 (MIN_EVIDENCE_SCORE 는 0~1)
# MAX_REGENERATIONS=2
# MIN_EVIDENCE_SCORE=0.3
# DEFAULT_CONTACT=안전관리팀

# 평가 파일 위치. 상대 경로는 저장소 루트 기준이고, TESTSET_PATH 와 SAVE_DIR 는 안 적으면 EVAL_ROOT 를 따라간다.
# EVAL_ROOT=eval
# TESTSET_PATH=eval/testsets/tech_qa.json
# SAVE_DIR=eval/save

# 업로드한 원본 PDF를 두는 폴더. 상대 경로는 저장소 루트 기준이다. {폴더}/{tech|secure}/{문서 id}.pdf 로 저장한다.
# PDF_STORAGE_DIR=mansa/data/documents
